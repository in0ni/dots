#!/usr/bin/env bash
set -u

readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
readonly SOFTWARE_CACHE="$CACHE_DIR/waybar-updates.software"
readonly FIRMWARE_CACHE="$CACHE_DIR/waybar-updates.firmware"
readonly MAX_LINES=15

usage() {
  printf 'Usage: %s refresh <software|firmware|all>\n' "${0##*/}" >&2
  printf '       %s display <software|firmware>\n' "${0##*/}" >&2
  exit 1
}

count_lines() {
  [[ -n ${1:-} ]] || {
    printf '0\n'
    return
  }
  printf '%s\n' "$1" | wc -l
}

trim_lines() {
  local input=$1 count
  count=$(count_lines "$input")

  if ((count > MAX_LINES)); then
    printf '%s\n...' "$(printf '%s\n' "$input" | head -n "$MAX_LINES")"
  else
    printf '%s' "$input"
  fi
}

normalize_tooltip() {
  local text=$1
  text=${text%$'\n'}
  text=${text//$'\n'/$'\r'}
  printf '%s' "$text"
}

# write_cache <file> <tooltip> <alt> [error...]
# With no errors, the result is also saved as the last good result
# (last_ok/last_ok_at; waybar ignores these extra keys). With errors, the cache
# gets alt=error and a tooltip listing the failures above the last good result,
# so a failed check never reads as "Up to date".
write_cache() {
  local file=$1 tooltip=$2 alt=$3
  shift 3
  local now last_ok='' last_ok_at='' err

  printf -v now '%(%a %b %d %H:%M)T' -1

  if (($# == 0)); then
    last_ok=$(normalize_tooltip "$tooltip")
    last_ok_at=$now
  else
    if [[ -f $file ]]; then
      last_ok=$(jq -r '.last_ok // empty' "$file" 2>/dev/null)
      last_ok_at=$(jq -r '.last_ok_at // empty' "$file" 2>/dev/null)
    fi

    alt='error'
    tooltip="Check failed ($now):"
    for err; do
      tooltip+=$'\n'"  $err"
    done
    if [[ -n $last_ok ]]; then
      tooltip+=$'\n\n'"Last successful check (${last_ok_at}):"$'\n'"$last_ok"
    fi
  fi

  tooltip=$(normalize_tooltip "$tooltip")

  jq -cn --arg tooltip "$tooltip" --arg alt "$alt" \
    --arg last_ok "$last_ok" --arg last_ok_at "$last_ok_at" \
    '{$tooltip, $alt, $last_ok, $last_ok_at}' >"$file"
}

read_cache() {
  local file=$1
  if [[ -f $file ]]; then
    cat "$file"
  else
    printf '{"tooltip":"cache missing","alt":"error"}\n'
  fi
}

append_block() {
  local label=$1
  local count=$2
  local body=$3

  [[ -n $body ]] || return 0

  printf '(%s) %s:\n%s\n' "$count" "$label" "$(printf '%s\n' "$body" | sed 's/^/  /')"
}

update_software() {
  local pac='' aur_updates='' svr='' rc
  local pac_count=0 aur_count=0 svr_count=0
  local tooltip='' alt='uptodate'
  local errors=()

  # checkupdates: 0 = updates, 2 = none, anything else = error (e.g. offline)
  pac=$(checkupdates --nocolor 2>/dev/null)
  rc=$?
  case $rc in
  0) ;;
  2) pac='' ;;
  *) errors+=("pac: checkupdates failed (exit $rc)") ;;
  esac
  pac_count=$(count_lines "$pac")

  if command -v aur >/dev/null 2>&1 && aur repo -d paks >/dev/null 2>&1; then
    # aur vercmp exits 0 with or without updates; pipefail catches either side failing
    aur_updates=$(
      set -o pipefail
      aur repo -d paks --list 2>/dev/null | aur vercmp 2>/dev/null
    )
    rc=$?
    ((rc == 0)) || errors+=("aur: query failed (exit $rc)")
    aur_count=$(count_lines "$aur_updates")
  fi

  if grep -q 'srv' "$HOME/.ssh/config" 2>/dev/null; then
    # ssh passes through checkupdates' exit code; 255 = ssh itself failed
    svr=$(ssh srv checkupdates 2>/dev/null)
    rc=$?
    case $rc in
    0) ;;
    2) svr='' ;;
    255) errors+=("svr: ssh failed (exit $rc)") ;;
    *) errors+=("svr: checkupdates failed (exit $rc)") ;;
    esac
    svr_count=$(count_lines "$svr")
  fi

  if ((${#errors[@]} > 0)); then
    write_cache "$SOFTWARE_CACHE" '' 'error' "${errors[@]}"
    return
  fi

  if ((pac_count == 0 && aur_count == 0 && svr_count == 0)); then
    tooltip='Up to date'
  else
    ((pac_count > 0)) && alt='pac' || alt='nopac'
    ((aur_count > 0)) && alt+='_aur'
    ((svr_count > 0)) && alt+='_svr'

    if ((svr_count > 0)); then
      tooltip+=$(append_block "svr" "$svr_count" "$(trim_lines "$svr")")
      tooltip+=$'\n'
    fi

    if ((aur_count > 0)); then
      tooltip+=$(append_block "aur" "$aur_count" "$(trim_lines "$aur_updates")")
      tooltip+=$'\n'
    fi

    if ((pac_count > 0)); then
      tooltip+=$(append_block "pac" "$pac_count" "$(trim_lines "$pac")")
      tooltip+=$'\n'
    fi
  fi

  write_cache "$SOFTWARE_CACHE" "$tooltip" "$alt"
}

update_firmware() {
  local raw='' parsed='' count=0 tooltip='' alt='uptodate' rc
  local errors=()

  # refresh: 0 = downloaded, 2 = metadata already current; stdout goes to the journal
  fwupdmgr refresh 2>/dev/null
  rc=$?
  ((rc == 0 || rc == 2)) || errors+=("lvfs: metadata refresh failed (exit $rc)")

  # get-updates: 0 = updates, 2 = none
  raw=$(fwupdmgr get-updates --json 2>/dev/null)
  rc=$?
  case $rc in
  0)
    if count=$(printf '%s' "$raw" | jq -e '[.Devices[]? | .Releases[]?] | length' 2>/dev/null); then
      parsed=$(
        printf '%s' "$raw" | jq -r '
          .Devices[]? as $d
          | $d.Releases[]?
          | "\($d.Name)\n   - \(.Version): \(.Summary)"
        '
      )
    else
      errors+=("fwupd: unreadable get-updates output")
    fi
    ;;
  2) count=0 ;;
  *) errors+=("fwupd: get-updates failed (exit $rc)") ;;
  esac

  if ((${#errors[@]} > 0)); then
    write_cache "$FIRMWARE_CACHE" '' 'error' "${errors[@]}"
    return
  fi

  if ((count == 0)); then
    tooltip='Up to date'
  else
    alt='outdated'
    tooltip=$(append_block "firmware" "$count" "$(trim_lines "$parsed")")
  fi

  write_cache "$FIRMWARE_CACHE" "$tooltip" "$alt"
}

case "${1:-}" in
display)
  case "${2:-}" in
  software) read_cache "$SOFTWARE_CACHE" ;;
  firmware) read_cache "$FIRMWARE_CACHE" ;;
  *) usage ;;
  esac
  ;;
refresh)
  case "${2:-}" in
  software) update_software ;;
  firmware) update_firmware ;;
  all)
    update_software
    update_firmware
    ;;
  *) usage ;;
  esac
  ;;
*)
  usage
  ;;
esac
