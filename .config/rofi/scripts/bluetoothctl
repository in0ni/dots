#!/usr/bin/env bash
#
# Written by Andrés González
#
# Inspired by rofi-bluetooth by Nick Clyde (clydedroid)
# Dependencies (arch): rofi, bluez-utils (bluetoothctl)
#
# TODO: systemd service
# TODO: add refresh, only when discovering
# TODO: look into using all icons below, might be too much
# TODO: multi-line notifications, or parse cmd output and simplify
# TODO: disable all features when powered off
# TODO: handle turning on/off service
# TODO: use coproc for all actions that take time
# TODO: pairing (low priority, never needed so far):
#   - run pair async with a "Pairing…" label, then auto trust + connect
#   - ensure a scan is running first (devices must be seen recently)
#   - no agent installed: on auth failure open `kitty -e bluetoothctl` to
#     enter/confirm the PIN (alt: bt-agent from bluez-tools as user service)

icon=
title=Bluetooth
icon_notify=blueman

# Controller states
declare -A ctrl=(
  [power]=Powered
  [scan]=Discovering
  [pair]=Pairable
  [discover]=Discoverable
)

# Device states
declare -A dev=(
  [connect]=Connected
  [pair]=Paired
  [trust]=Trusted
)

# Fontawesome, some currently unused
declare -A icons_rofi
icons_rofi[toggle_on]=
icons_rofi[toggle_off]=
icons_rofi[back]=
icons_rofi[pending]=
source "$(dirname "$0")/common/utils"

back=back
scan_timeout=30
scan_pidfile="${XDG_RUNTIME_DIR:-/tmp}/rofi-bluetoothctl-scan.pid"
is_service_active() {
  if systemctl is-active bluetooth.service --quiet; then
    return 0
  else
    return 1
  fi
}

# STATE TESTS
is_ctrl_state_on() {
  if bluetoothctl show | grep -q "$1: yes"; then
    return 0
  else
    return 1
  fi
}

is_dev_state_on() {
  device_info=$(bluetoothctl info "$1")
  if echo "$device_info" | grep -q "$2: yes"; then
    return 0
  else
    return 1
  fi
}

# STATE TOGGLES
# toggles powered state
toggle_power() {
  if is_ctrl_state_on "${ctrl[power]}"; then
    cmd=$(bluetoothctl power off)
    ret=$?
  else
    if rfkill list bluetooth | grep -q 'blocked: yes'; then
      # TODO: check this, seems like requires sudo, so perhaps useless.
      notify "Device disabled (rfkill), enabling device..."
      rfkill unblock bluetooth && sleep 3
    fi

    # TODO: unable to get output on two lines, as it should be
    cmd=$(bluetoothctl power on)
    ret=$?
  fi

  # on success keep only the status line; on failure show everything
  local msg
  if [[ $ret == 0 ]]; then
    msg=$(grep "Changing power" <<<"$cmd")
  fi
  notify "${msg:-$cmd}" $ret
}

# prints pid of the scan process started by this script, if still running
our_scan_pid() {
  local pid
  [[ -r $scan_pidfile ]] || return 1
  read -r pid <"$scan_pidfile"
  # guard against stale pidfile / pid reuse
  if [[ -n $pid ]] && grep -qa 'scan' "/proc/$pid/cmdline" 2>/dev/null; then
    echo "$pid"
    return 0
  fi
  rm -f "$scan_pidfile"
  return 1
}

# Toggles scanning state
# NOTE: bluez discovery is per-client, so only a scan started here can be stopped here
toggle_scan() {
  local pid
  if is_ctrl_state_on "${ctrl[scan]}"; then
    if pid=$(our_scan_pid); then
      kill "$pid"
      notify "Stopped scanning" $?
      rm -f "$scan_pidfile"
      sleep 1
    else
      notify "Discovery was started by another program, stop it there" 1
    fi
  else
    bluetoothctl --timeout "$scan_timeout" scan on &>/dev/null &
    echo $! >"$scan_pidfile"
    notify "Scanning for ${scan_timeout}s..."
    sleep 1
  fi
}

# Toggles pairable state
toggle_pairable() {
  if is_ctrl_state_on "${ctrl[pair]}"; then
    cmd=$(bluetoothctl pairable off)
    ret=$?
  else
    cmd=$(bluetoothctl pairable on)
    ret=$?
  fi

  notify "$cmd" $ret
}

# Toggles discoverable state
toggle_discoverable() {
  if is_ctrl_state_on "${ctrl[discover]}"; then
    cmd=$(bluetoothctl discoverable off)
    ret=$?
  else
    cmd=$(bluetoothctl discoverable on)
    ret=$?
  fi

  notify "$cmd" $ret
}

# Toggles device connection (async); sets $pending to a label for the redraw
toggle_connection() {
  local action
  if is_dev_state_on "$1" "${dev[connect]}"; then
    action=disconnect
    pending="Disconnecting…"
  else
    action=connect
    pending="Connecting…"
  fi

  # fully detached so rofi isn't kept waiting on our stdout
  {
    cmd=$(bluetoothctl "$action" "$1")
    notify "$cmd" $?
  } &>/dev/null &
}

# Toggles device paired state; sets $removed=1 when the device was removed
toggle_paired() {
  if is_dev_state_on "$1" "${dev[pair]}"; then
    cmd=$(bluetoothctl remove "$1")
    ret=$?
    [[ $ret == 0 ]] && removed=1
  else
    cmd=$(bluetoothctl pair "$1")
    ret=$?
  fi

  notify "$cmd" $ret
}

# Toggles device connection
toggle_trust() {
  if is_dev_state_on "$1" "${dev[trust]}"; then
    cmd=$(bluetoothctl untrust "$1")
    ret=$?
  else
    cmd=$(bluetoothctl trust "$1")
    ret=$?
  fi

  notify "$cmd" $ret
}

list_devices() {
  output=$(bluetoothctl devices | awk '/^Device/{
    # get substr of $0 starting at index $3
    name=substr($0, index($0, $3))
    mac=$2
    printf "%s\\0info\x1f%s\n", name, mac
  }')
  echo -e "$output"
}

# Usage: toggle <state-name> <test-exit-code> [mac] [pending-label]
toggle() {
  local glyph info label=$1
  [[ $2 == 0 ]] && glyph=${icons_rofi[toggle_on]} || glyph=${icons_rofi[toggle_off]}
  [[ -n $3 ]] && info="$1":"$3" || info="$1"
  if [[ -n $4 ]]; then
    glyph=${icons_rofi[pending]}
    label=$4
  fi
  echo -en "$glyph  $label\0info\x1f$info\n"
}

show_menu() {
  if is_service_active; then
    is_ctrl_state_on "${ctrl[power]}"
    toggle "${ctrl[power]}" $?

    if is_ctrl_state_on "${ctrl[power]}"; then
      if ! is_ctrl_state_on "${ctrl[scan]}"; then
        toggle "${ctrl[scan]}" 1
      elif our_scan_pid >/dev/null; then
        toggle "${ctrl[scan]}" 0
      else
        toggle "${ctrl[scan]}" 0 "" "${ctrl[scan]} (other program)"
      fi

      is_ctrl_state_on "${ctrl[pair]}"
      toggle "${ctrl[pair]}" $?

      is_ctrl_state_on "${ctrl[discover]}"
      toggle "${ctrl[discover]}" $?

      print_divider
      list_devices
    fi
  else
    set_message "Bluetooth service is <b>off</b>"
    # TODO: allow starting from here
    # echo -en "Start bluetooth service (systemd)\0info"
  fi
}

set_title $title
set_message ""

device_menu() {
  mac=$1
  name=$(bluetoothctl devices | grep "$mac" | cut -d ' ' -f 3-)

  set_subtitle "$name"

  # shellcheck disable=SC2086,SC2027
  is_dev_state_on "$mac" ""${dev[connect]}""
  # shellcheck disable=SC2086,SC2027
  toggle ""${dev[connect]}"" $? "$mac" "${pending:-}"

  # shellcheck disable=SC2086,SC2027
  is_dev_state_on "$mac" ""${dev[pair]}""
  # shellcheck disable=SC2086,SC2027
  toggle ""${dev[pair]}"" $? "$mac"

  # shellcheck disable=SC2086,SC2027
  is_dev_state_on "$mac" ""${dev[trust]}""
  # shellcheck disable=SC2086,SC2027
  toggle ""${dev[trust]}"" $? "$mac"

  print_divider
  echo -en "${icons_rofi[back]}  Back\0info\x1f$back\n"
}

if [[ $ROFI_RETV == 0 ]]; then
  show_menu
elif [[ $ROFI_RETV == 1 ]]; then
  case "$ROFI_INFO" in
  "$back")
    show_menu
    ;;
  "${ctrl[power]}")
    toggle_power
    show_menu
    ;;
  "${ctrl[scan]}")
    toggle_scan
    show_menu
    ;;
  "${ctrl[pair]}")
    toggle_pairable
    show_menu
    ;;
  "${ctrl[discover]}")
    toggle_discoverable
    show_menu
    ;;
  "${dev[connect]}":*)
    mac=${ROFI_INFO#*"${dev[connect]}":}
    toggle_connection "$mac"
    device_menu "$mac"
    ;;
  "${dev[pair]}":*)
    mac=${ROFI_INFO#*"${dev[pair]}":}
    toggle_paired "$mac"
    if [[ ${removed:-0} == 1 ]]; then
      show_menu
    else
      device_menu "$mac"
    fi
    ;;
  "${dev[trust]}":*)
    mac=${ROFI_INFO#*"${dev[trust]}":}
    toggle_trust "$mac"
    device_menu "$mac"
    ;;
  *)
    device_menu "$ROFI_INFO"
    ;;
  esac
fi
