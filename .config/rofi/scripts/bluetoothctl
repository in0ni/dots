#!/usr/bin/env bash
# shellcheck disable=SC2034  # icon/title/icon_notify/icons_rofi are consumed by common/util
set -uo pipefail
#
# Written by Andrés González
#
# Inspired by rofi-bluetooth by Nick Clyde (clydedroid)
# Dependencies (arch): rofi, bluez-utils (bluetoothctl), util-linux (rfkill), libnotify
#
# Pending work: see TODO.md (# Bluetoothctl)

icon=$''
title=Bluetooth
icon_notify=blueman

# Controller states
declare -A ctrl=(
  [power]=Powered
  [scan]=Discovering
  [pair]=Pairable
  [discover]=Discoverable
)

# Device states
declare -A dev=(
  [connect]=Connected
  [pair]=Paired
  [trust]=Trusted
)

# Fontawesome
declare -A icons_rofi=(
  [toggle_on]=$''
  [toggle_off]=$''
  [back]=$''
  [pending]=$''
  [service]=$''
  [warn]=$''
)

# shellcheck disable=SC1091  # common/util is a local shared library
source "$(dirname "$0")/common/util"

back=back
start_service=start_service
scan_timeout=30
scan_pidfile="${XDG_RUNTIME_DIR:-/tmp}/rofi-bluetoothctl-scan.pid"

is_service_active() {
  systemctl is-active bluetooth.service --quiet
}

has_controller() {
  [[ -n $(bluetoothctl list 2>/dev/null) ]]
}

# STATE TESTS
# NOTE: here-strings instead of `cmd | grep -q`: with pipefail, grep -q exiting
# early SIGPIPEs the producer and the test would report a false negative.
is_ctrl_state_on() {
  grep -q "$1: yes" <<<"$(bluetoothctl show)"
}

is_dev_state_on() {
  grep -q "$2: yes" <<<"$(bluetoothctl info "$1")"
}

# Starts bluetooth.service (polkit prompt). Runs detached and prints nothing,
# so rofi closes and the polkit dialog can take focus; reopens the menu on success.
start_bluetooth_service() {
  {
    if systemctl start bluetooth.service; then
      notify "Bluetooth service started"
      sleep 1
      rofi -show bluetoothctl
    else
      notify "Failed to start bluetooth service" 1
    fi
  } &>/dev/null &
  disown
}

# Unblocks bluetooth via rfkill if needed and waits for the controller to come back.
# Returns 1 if it cannot be unblocked (hard block / timeout).
ensure_unblocked() {
  local state
  state=$(rfkill list bluetooth)
  grep -q 'blocked: yes' <<<"$state" || return 0

  if grep -q 'Hard blocked: yes' <<<"$state"; then
    notify "Bluetooth is hard blocked (hardware switch / BIOS)" 1
    return 1
  fi

  notify "Bluetooth soft blocked (rfkill), unblocking..."
  rfkill unblock bluetooth || {
    notify "rfkill unblock failed" 1
    return 1
  }

  # wait up to 5s for the controller to be usable again
  for _ in {1..10}; do
    ! grep -q 'blocked: yes' <<<"$(rfkill list bluetooth)" && has_controller && return 0
    sleep 0.5
  done
  notify "Controller did not come back after rfkill unblock" 1
  return 1
}

# STATE TOGGLES
# toggles powered state
toggle_power() {
  local cmd ret msg=""
  if is_ctrl_state_on "${ctrl[power]}"; then
    cmd=$(bluetoothctl power off)
    ret=$?
  else
    ensure_unblocked || return 1
    cmd=$(bluetoothctl power on)
    ret=$?
  fi

  # on success keep only the status line; on failure show everything
  if [[ $ret == 0 ]]; then
    msg=$(grep "Changing power" <<<"$cmd")
  fi
  notify "${msg:-$cmd}" $ret
}

# prints pid of the scan process started by this script, if still running
our_scan_pid() {
  local pid
  [[ -r $scan_pidfile ]] || return 1
  read -r pid <"$scan_pidfile"
  # guard against stale pidfile / pid reuse
  if [[ -n $pid ]] && grep -qa 'scan' "/proc/$pid/cmdline" 2>/dev/null; then
    echo "$pid"
    return 0
  fi
  rm -f "$scan_pidfile"
  return 1
}

# Toggles scanning state
# NOTE: bluez discovery is per-client, so only a scan started here can be stopped here
toggle_scan() {
  local pid
  if is_ctrl_state_on "${ctrl[scan]}"; then
    if pid=$(our_scan_pid); then
      kill "$pid"
      notify "Stopped scanning" $?
      rm -f "$scan_pidfile"
      sleep 1
    else
      notify "Discovery was started by another program, stop it there" 1
    fi
  else
    bluetoothctl --timeout "$scan_timeout" scan on &>/dev/null &
    echo $! >"$scan_pidfile"
    notify "Scanning for ${scan_timeout}s..."
    sleep 1
  fi
}

# Toggles pairable state
toggle_pairable() {
  local cmd ret
  if is_ctrl_state_on "${ctrl[pair]}"; then
    cmd=$(bluetoothctl pairable off)
    ret=$?
  else
    cmd=$(bluetoothctl pairable on)
    ret=$?
  fi

  notify "$cmd" $ret
}

# Toggles discoverable state
toggle_discoverable() {
  local cmd ret
  if is_ctrl_state_on "${ctrl[discover]}"; then
    cmd=$(bluetoothctl discoverable off)
    ret=$?
  else
    cmd=$(bluetoothctl discoverable on)
    ret=$?
  fi

  notify "$cmd" $ret
}

# Toggles device connection (async); sets $pending to a label for the redraw
toggle_connection() {
  local action
  if is_dev_state_on "$1" "${dev[connect]}"; then
    action=disconnect
    pending="Disconnecting…"
  else
    action=connect
    pending="Connecting…"
  fi

  # fully detached so rofi isn't kept waiting on our stdout
  {
    cmd=$(bluetoothctl "$action" "$1")
    notify "$cmd" $?
  } &>/dev/null &
}

# Toggles device paired state; sets $removed=1 when the device was removed
toggle_paired() {
  local cmd ret
  if is_dev_state_on "$1" "${dev[pair]}"; then
    cmd=$(bluetoothctl remove "$1")
    ret=$?
    [[ $ret == 0 ]] && removed=1
  else
    cmd=$(bluetoothctl pair "$1")
    ret=$?
  fi

  notify "$cmd" $ret
}

# Toggles device trust
toggle_trust() {
  local cmd ret
  if is_dev_state_on "$1" "${dev[trust]}"; then
    cmd=$(bluetoothctl untrust "$1")
    ret=$?
  else
    cmd=$(bluetoothctl trust "$1")
    ret=$?
  fi

  notify "$cmd" $ret
}

list_devices() {
  local output
  output=$(bluetoothctl devices | awk '/^Device/{
    # get substr of $0 starting at index $3
    name=substr($0, index($0, $3))
    mac=$2
    printf "%s\\0info\x1f%s\n", name, mac
  }')
  echo -e "$output"
}

# Usage: toggle <state-name> <test-exit-code> [mac] [pending-label]
toggle() {
  local glyph info label=$1
  [[ $2 == 0 ]] && glyph=${icons_rofi[toggle_on]} || glyph=${icons_rofi[toggle_off]}
  [[ -n ${3:-} ]] && info="$1":"$3" || info="$1"
  if [[ -n ${4:-} ]]; then
    glyph=${icons_rofi[pending]}
    label=$4
  fi
  echo -en "$glyph  $label\0info\x1f$info\n"
}

# non-selectable informational row (rofi quits if a script returns no entries)
print_notice() {
  echo -en "${icons_rofi[warn]}  $1\0nonselectable\x1ftrue\n"
}

show_menu() {
  if ! is_service_active; then
    set_message "Bluetooth service is <b>off</b>"
    echo -en "${icons_rofi[service]}  Start bluetooth service\0info\x1f$start_service\n"
    return
  fi

  if ! has_controller; then
    set_message "No bluetooth controller found"
    print_notice "Check: rfkill list bluetooth / journalctl -u bluetooth"
    return
  fi

  is_ctrl_state_on "${ctrl[power]}"
  toggle "${ctrl[power]}" $?

  if is_ctrl_state_on "${ctrl[power]}"; then
    if ! is_ctrl_state_on "${ctrl[scan]}"; then
      toggle "${ctrl[scan]}" 1
    elif our_scan_pid >/dev/null; then
      toggle "${ctrl[scan]}" 0
    else
      toggle "${ctrl[scan]}" 0 "" "${ctrl[scan]} (other program)"
    fi

    is_ctrl_state_on "${ctrl[pair]}"
    toggle "${ctrl[pair]}" $?

    is_ctrl_state_on "${ctrl[discover]}"
    toggle "${ctrl[discover]}" $?

    print_divider
    list_devices
  fi
}

device_menu() {
  mac=$1
  name=$(bluetoothctl devices | grep "$mac" | cut -d ' ' -f 3-)

  set_subtitle "$name" ""

  # shellcheck disable=SC2086,SC2027
  is_dev_state_on "$mac" ""${dev[connect]}""
  # shellcheck disable=SC2086,SC2027
  toggle ""${dev[connect]}"" $? "$mac" "${pending:-}"

  # shellcheck disable=SC2086,SC2027
  is_dev_state_on "$mac" ""${dev[pair]}""
  # shellcheck disable=SC2086,SC2027
  toggle ""${dev[pair]}"" $? "$mac"

  # shellcheck disable=SC2086,SC2027
  is_dev_state_on "$mac" ""${dev[trust]}""
  # shellcheck disable=SC2086,SC2027
  toggle ""${dev[trust]}"" $? "$mac"

  print_divider
  echo -en "${icons_rofi[back]}  Back\0info\x1f$back\n"
}

ROFI_RETV=${ROFI_RETV:-0}
ROFI_INFO=${ROFI_INFO:-}
removed=0
pending=""

# starting the service closes rofi: print nothing at all
if [[ $ROFI_RETV == 1 && $ROFI_INFO == "$start_service" ]]; then
  start_bluetooth_service
  exit 0
fi

set_prompt "$title"
set_message ""

if [[ $ROFI_RETV == 0 ]]; then
  show_menu
elif [[ $ROFI_RETV == 1 ]]; then
  case "$ROFI_INFO" in
  "$back")
    show_menu
    ;;
  "${ctrl[power]}")
    toggle_power
    show_menu
    ;;
  "${ctrl[scan]}")
    toggle_scan
    show_menu
    ;;
  "${ctrl[pair]}")
    toggle_pairable
    show_menu
    ;;
  "${ctrl[discover]}")
    toggle_discoverable
    show_menu
    ;;
  "${dev[connect]}":*)
    mac=${ROFI_INFO#*"${dev[connect]}":}
    toggle_connection "$mac"
    device_menu "$mac"
    ;;
  "${dev[pair]}":*)
    mac=${ROFI_INFO#*"${dev[pair]}":}
    toggle_paired "$mac"
    if [[ $removed == 1 ]]; then
      show_menu
    else
      device_menu "$mac"
    fi
    ;;
  "${dev[trust]}":*)
    mac=${ROFI_INFO#*"${dev[trust]}":}
    toggle_trust "$mac"
    device_menu "$mac"
    ;;
  *)
    device_menu "$ROFI_INFO"
    ;;
  esac
fi
