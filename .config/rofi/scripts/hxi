#!/usr/bin/env bash

icon=
title="Helix Projects"
icon_notify=helix
# shellcheck disable=SC1091  # common/util is a local shared library
source "$(dirname "$0")/common/util"

set_prompt "$title"

# manually managed projects
projs=~/.config/hxi.projs

# automatically scanned directory
uw2_tickets=~/Work/un/tickets
uw2_repos=~/Work/un/repos

# Hyprland >= 0.55 uses a Lua config; `hyprctl dispatch` now evaluates its
# argument as Lua (hl.dispatch(...)), so the legacy "exec foo" / "movefocus u"
# strings no longer parse. [[...]] is a Lua long string, so the command may
# contain double quotes without escaping.
# dispatch Lua; surface errors as notifications instead of discarding them
hypr() {
  local out
  out=$(hyprctl dispatch "$1" 2>&1)
  [[ $out == ok ]] || notify "hyprctl dispatch failed: $1"$'\n'"$out" 1
}
hypr_exec() { hypr "hl.dsp.exec_cmd([[$1]])"; }

# helix's share of the height (dwindle split ratio = 2 * share: 1.0 = 50%, 1.5 = 75%; range 0.1-1.9)
hx_ratio=1.5

client_addrs() { hyprctl clients -j | jq -r '.[].address' | sort; }

# Launches $1 and blocks until its window has mapped (max 5s).
# Fixed sleeps raced kitty's startup: layout messages landed before the window
# existed, or windows mapped out of order, scrambling the tree.
spawn_and_wait() {
  local before
  before=$(client_addrs)
  hypr_exec "$1"
  for _ in {1..50}; do
    sleep 0.1
    [[ -n $(comm -13 <(echo "$before") <(client_addrs)) ]] && return 0
  done
  notify "Window did not open: $1" 1
  return 1
}

# Layout (dwindle):  +-----------------+
#                    |      helix      |
#                    +--------+--------+
#                    | term1  | term2  |
#                    +--------+--------+
# preselect sets the split direction for the *next* window explicitly, instead
# of relying on force_split + aspect ratio + togglesplit. A newly mapped window
# gets focus, so each preselect applies to the window opened just before.
helix_cd() {
  kitten="kitty --directory=$1"
  hx="$kitten -T \"$icon ~ $2 (editor)\" --hold helix"
  term1="$kitten -T \"$icon ~ $2 (term1)\""
  term2="$kitten -T \"$icon ~ $2 (term2)\""

  # detached so rofi closes immediately
  {
    spawn_and_wait "$hx" || exit 1
    hypr 'hl.dsp.layout("preselect d")'
    spawn_and_wait "$term1" || exit 1
    hypr 'hl.dsp.layout("preselect r")'
    spawn_and_wait "$term2" || exit 1
    hypr 'hl.dsp.focus({ direction = "up" })'
    # 0.57 syntax: "splitratio <value> exact" (value first; "exact <value>" fails to parse)
    hypr "hl.dsp.layout(\"splitratio $hx_ratio exact\")"
  } &>/dev/null &
}

if [[ $ROFI_RETV == 0 ]]; then
  # initial list
  projs_file=$(awk -F':' '{
    printf "%s (%s)\\0info\x1f%s:%s\n", $2, $1, $1, $2
  }' <"$projs")

  projs_uw_tickets=$(fd -d1 -td -i 'uw2' "$uw2_tickets" |
    awk -F'/' '{
    printf "ticket: %s\\0info\x1f%s:%s\n", $(NF-1), $0, $(NF-1)
  }')

  projs_uw_base=$(fd -d1 -td -H --regex '^.uw-.+-git$' "$uw2_tickets" |
    awk -F'/' '{
    name=$(NF-1)
    name=gensub(/\.uw-/, "", "g", name)
    name=gensub(/-git/, "", "g", name)
    printf "base: %s\\0info\x1f%s:%s\n", name, $0, name
  }')

  projs_uw_repos=$(fd -d1 -td "." "$uw2_repos" |
    awk -F'/' '{
    printf "repo: %s\\0info\x1f%s:%s\n", $(NF-1), $0, $(NF-1)
  }')

  echo -en "$projs_file\n"
  print_divider
  echo -en "$projs_uw_tickets\n"
  echo -en "$projs_uw_base\n"
  echo -en "$projs_uw_repos\n"
fi

if [[ $ROFI_RETV == 1 ]]; then
  IFS=":" read -r -a data <<<"$ROFI_INFO"
  helix_cd "${data[0]}" "${data[1]}"
fi
