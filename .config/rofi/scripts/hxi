#!/usr/bin/env bash

icon=
title="Helix Projects"
# icon_notify=dialog-password-panel
source "$(dirname "$0")/common/utils" "$icon" "$title"

set_title "$title"

# manually managed projects
projs=~/.config/hxi.projs

# automatically scanned directory
uw2_tickets=~/Work/un/tickets
uw2_repos=~/Work/un/repos

# Hyprland >= 0.55 uses a Lua config; `hyprctl dispatch` now evaluates its
# argument as Lua (hl.dispatch(...)), so the legacy "exec foo" / "movefocus u"
# strings no longer parse. [[...]] is a Lua long string, so the command may
# contain double quotes without escaping.
hypr_exec() { hyprctl dispatch "hl.dsp.exec_cmd([[$1]])"; }

helix_cd() {
  kitten="kitty --directory=$1"
  hx="$kitten -T \"$icon ~ $2 (editor)\" --hold helix"
  term1="$kitten -T \"$icon ~ $2 (term1)\""
  term2="$kitten -T \"$icon ~ $2 (term2)\""

  coproc {
    hypr_exec "$hx"
    sleep 0.2
    hypr_exec "$term1"
    sleep 0.2
    hyprctl dispatch 'hl.dsp.layout("togglesplit")'
    sleep 0.2
    hypr_exec "$term2"
    sleep 0.2
    # was: resizeactive 0 50% -- the % was relative to the active window's own
    # height, and the Lua dispatcher takes pixels, so compute the delta here.
    # Without relative=true, x/y are an absolute size ("Invalid size" on 0).
    h=$(hyprctl activewindow -j | jq -r '.size[1]')
    hyprctl dispatch "hl.dsp.window.resize({ x = 0, y = $((h / 2)), relative = true })"
    sleep 0.2
    hyprctl dispatch 'hl.dsp.focus({ direction = "up" })'
  }
}

if [[ $ROFI_RETV == 0 ]]; then
  # initial list
  projs_file=$(awk -F':' '{
    printf "%s (%s)\\0info\x1f%s:%s\n", $2, $1, $1, $2
  }' <"$projs")

  projs_uw_tickets=$(fd -d1 -td -i 'uw2' "$uw2_tickets" |
    awk -F'/' '{
    printf "ticket: %s\\0info\x1f%s:%s\n", $(NF-1), $0, $(NF-1)
  }')

  projs_uw_base=$(fd -d1 -td -H --regex '^.uw-.+-git$' "$uw2_tickets" |
    awk -F'/' '{
    name=$(NF-1)
    name=gensub(/\.uw-/, "", "g", name)
    name=gensub(/-git/, "", "g", name)
    printf "base: %s\\0info\x1f%s:%s\n", name, $0, name
  }')

  projs_uw_repos=$(fd -d1 -td "." "$uw2_repos" |
    awk -F'/' '{
    printf "repo: %s\\0info\x1f%s:%s\n", $(NF-1), $0, $(NF-1)
  }')

  echo -en "$projs_file\n"
  print_divider
  echo -en "$projs_uw_tickets\n"
  echo -en "$projs_uw_base\n"
  echo -en "$projs_uw_repos\n"
fi

if [[ $ROFI_RETV == 1 ]]; then
  IFS=":" read -r -a data <<<"$ROFI_INFO"
  helix_cd "${data[0]}" "${data[1]}"
fi
